<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.carptalk.update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/takesue/carp-talk/scripts/local_update.sh</string>
    </array>

    <!-- launchd は最小PATHで動くので、node/npx/git のある場所を明示する -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- JST 8:00〜23:59 の毎時 :05 / :25 / :45 に実行（20分間隔） -->
    <!-- launchd はローカルタイム（Mac のTZ）で解釈。日本のMacなら JST。 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <!-- スリープで発火を逃しても、復帰時にまとめて1回実行される -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/takesue/carp-talk/.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/takesue/carp-talk/.launchd.err.log</string>
</dict>
</plist>
